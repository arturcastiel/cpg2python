-- simple_faulted_2x2x2.grdecl
-- 2x2x2 cartesian deck with a HALF-CELL Z FAULT between i=0 and i=1.
-- All cells active. Vertical pillars from z=0 to z=3 (extra headroom
-- to accommodate the offset i=1 column bottom at z=2.5).
--
-- Cells at i=0 column: top z = 0, bot z = 1 (k=0);  top 1, bot 2 (k=1)
-- Cells at i=1 column: top z = 0.5, bot 1.5 (k=0); top 1.5, bot 2.5 (k=1)
--
-- Expected behaviour against the mask helpers:
--   _faulted_pillar_mask_i → (1, 2, 2) all-True
--   _faulted_pillar_mask_j → (2, 1, 2) all-False
--   _faulted_pillar_mask_k → (2, 2, 1) all-False

SPECGRID
  2 2 2 1 F /

COORD
  0 0 0  0 0 3
  1 0 0  1 0 3
  2 0 0  2 0 3
  0 1 0  0 1 3
  1 1 0  1 1 3
  2 1 0  2 1 3
  0 2 0  0 2 3
  1 2 0  1 2 3
  2 2 0  2 2 3  /

-- ZCORN: 4 slices × 16 values, F-order (i fastest, then j, then k-slot).
-- Slice 0 = top of k=0 layer; slice 1 = bot of k=0; slice 2 = top of k=1;
-- slice 3 = bot of k=1.  Per (i-slot, j-slot) at each slice, z value is:
--   i-slot ∈ {0,1}  →  i=0 column z (no offset)
--   i-slot ∈ {2,3}  →  i=1 column z (offset +0.5)

ZCORN
  -- slice 0  (top of k=0)
  0   0   0.5 0.5    0   0   0.5 0.5    0   0   0.5 0.5    0   0   0.5 0.5
  -- slice 1  (bot of k=0)
  1   1   1.5 1.5    1   1   1.5 1.5    1   1   1.5 1.5    1   1   1.5 1.5
  -- slice 2  (top of k=1)  — matches slice 1 along k → no k-fault
  1   1   1.5 1.5    1   1   1.5 1.5    1   1   1.5 1.5    1   1   1.5 1.5
  -- slice 3  (bot of k=1)
  2   2   2.5 2.5    2   2   2.5 2.5    2   2   2.5 2.5    2   2   2.5 2.5  /

ACTNUM
  8*1 /
