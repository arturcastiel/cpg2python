-- simple_faulted_3x3x2.grdecl
-- 3x3x2 cartesian deck with a multi-column i-direction fault.
-- All cells active. Vertical pillars from z=0 to z=3.
--
-- Z layout per i-column:
--   i ∈ {0, 1}  → top z = k          (flat unit cubes)
--   i =  2      → top z = k + 0.6    (+0.6 Z offset across the fault)
--
-- Fault plane: between i=1 and i=2 columns, across all 3 j-rows.
-- The +0.6 offset makes the upper cell on the i=1 side straddle
-- both cells on the i=2 side, so each faulted pillar stack yields
-- 3 connections (not 2): 3 j-rows × 3 conns = 9 fault faces.
--
-- This is the regression fixture for PR-9 of phase 2-faults — it
-- exercises the find_i_faces dispatch on a multi-row grid (the
-- 2x2x2 fixtures only have 2 j-rows each).

SPECGRID
  3 3 2 1 F /

COORD
  0 0 0  0 0 3
  1 0 0  1 0 3
  2 0 0  2 0 3
  3 0 0  3 0 3
  0 1 0  0 1 3
  1 1 0  1 1 3
  2 1 0  2 1 3
  3 1 0  3 1 3
  0 2 0  0 2 3
  1 2 0  1 2 3
  2 2 0  2 2 3
  3 2 0  3 2 3
  0 3 0  0 3 3
  1 3 0  1 3 3
  2 3 0  2 3 3
  3 3 0  3 3 3  /

-- ZCORN: 4 slices × (2*3 x 2*3) = 4 × 36 values, F-order (i fastest,
-- then j, then k-slot).
-- Per slice: 6 j-slots × 6 i-slots. Within each j-row of 6 values,
-- i-slots {0,1,2,3} get the base z; i-slots {4,5} get z + 0.6.

ZCORN
  -- slice 0  (top of k=0 cells)
  0   0   0   0   0.6 0.6     0   0   0   0   0.6 0.6     0   0   0   0   0.6 0.6
  0   0   0   0   0.6 0.6     0   0   0   0   0.6 0.6     0   0   0   0   0.6 0.6
  -- slice 1  (bot of k=0 cells)
  1   1   1   1   1.6 1.6     1   1   1   1   1.6 1.6     1   1   1   1   1.6 1.6
  1   1   1   1   1.6 1.6     1   1   1   1   1.6 1.6     1   1   1   1   1.6 1.6
  -- slice 2  (top of k=1 cells) — matches slice 1 → no k-fault
  1   1   1   1   1.6 1.6     1   1   1   1   1.6 1.6     1   1   1   1   1.6 1.6
  1   1   1   1   1.6 1.6     1   1   1   1   1.6 1.6     1   1   1   1   1.6 1.6
  -- slice 3  (bot of k=1 cells)
  2   2   2   2   2.6 2.6     2   2   2   2   2.6 2.6     2   2   2   2   2.6 2.6
  2   2   2   2   2.6 2.6     2   2   2   2   2.6 2.6     2   2   2   2   2.6 2.6  /

ACTNUM
  18*1 /
