-- pinched_1x1x3.grdecl
-- Single column, 3 k-layers, middle layer (k=1) pinched out.
-- All cells ACTNUM=1; the pinch is geometric (zero thickness).
--
-- Z layout (vertical pillars, z 0..2):
--   k=0 : top z=0, bottom z=1   (unit thickness)
--   k=1 : top z=1, bottom z=1   (PINCHED - zero thickness)
--   k=2 : top z=1, bottom z=2   (unit thickness)
--
-- After pinch detection the k=1 cell is dropped; k=0 and k=2 become
-- vertically non-adjacent.  will bridge them with an NNC.
--  - pinched-cell detection + drop.

SPECGRID
  1 1 3 1 F /

COORD
  0 0 0  0 0 2
  1 0 0  1 0 2
  0 1 0  0 1 2
  1 1 0  1 1 2  /

-- ZCORN: 2*NZ = 6 k-slots, each 2*1 x 2*1 = 4 vals, F-order
-- (i fastest, then j, then k-slot). Two k-slots per cell layer.
ZCORN
  -- k=0:  top z=0  then  bot z=1
  0 0 0 0
  1 1 1 1
  -- k=1:  top z=1  then  bot z=1   (collapsed: top == bottom)
  1 1 1 1
  1 1 1 1
  -- k=2:  top z=1  then  bot z=2
  1 1 1 1
  2 2 2 2 /

ACTNUM
  3*1 /
