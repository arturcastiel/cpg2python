-- quickstart.grdecl — self-contained 5x5x3 deck for cpg2unstructured examples.
-- Unit cubes, mild PORO heterogeneity by layer (0.15 / 0.20 / 0.25),
-- 5 inactive cells in the bottom k=2 layer to exercise active-cell
-- filtering through the full pipeline.

SPECGRID
  5 5 3 1 F /

COORD
  0 0 0  0 0 3
  1 0 0  1 0 3
  2 0 0  2 0 3
  3 0 0  3 0 3
  4 0 0  4 0 3
  5 0 0  5 0 3
  0 1 0  0 1 3
  1 1 0  1 1 3
  2 1 0  2 1 3
  3 1 0  3 1 3
  4 1 0  4 1 3
  5 1 0  5 1 3
  0 2 0  0 2 3
  1 2 0  1 2 3
  2 2 0  2 2 3
  3 2 0  3 2 3
  4 2 0  4 2 3
  5 2 0  5 2 3
  0 3 0  0 3 3
  1 3 0  1 3 3
  2 3 0  2 3 3
  3 3 0  3 3 3
  4 3 0  4 3 3
  5 3 0  5 3 3
  0 4 0  0 4 3
  1 4 0  1 4 3
  2 4 0  2 4 3
  3 4 0  3 4 3
  4 4 0  4 4 3
  5 4 0  5 4 3
  0 5 0  0 5 3
  1 5 0  1 5 3
  2 5 0  2 5 3
  3 5 0  3 5 3
  4 5 0  4 5 3
  5 5 0  5 5 3  /

ZCORN
  100*0   100*1
  100*1   100*2
  100*2   100*3 /

ACTNUM
  -- 70 active cells: all of layers k=0 and k=1, plus 20 of k=2.
  -- Last 5 cells of the k=2 layer are inactive (exercises filtering).
  70*1   5*0 /

PORO
  -- Per-layer mild heterogeneity. 25 cells per layer.
  25*0.15   25*0.20   25*0.25 /
